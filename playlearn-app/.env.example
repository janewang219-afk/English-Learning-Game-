# ==================== PlayLearn 环境变量样例 ====================
# 复制为 .env 并填入实际值

NODE_ENV="development"
APP_TIMEZONE="Asia/Shanghai"

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://playlearn:playlearn@localhost:5432/playlearn?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL_SEC="900"        # 15 分钟
JWT_REFRESH_TTL_SEC="2592000"    # 30 天
JWT_CHILD_TTL_SEC="1800"         # 30 分钟，儿童端短期 token

# ---- 第三方语音识别 API ----
# mock | http；本地默认使用确定性 mock，不上传音频
SPEECH_PROVIDER="mock"
# Azure Speech / 阿里云语音服务凭证
SPEECH_API_BASE_URL="https://example.com/speech"
SPEECH_API_KEY=""
SPEECH_API_TIMEOUT_MS="3000"
SPEECH_MAX_AUDIO_BYTES="1048576"

# ---- 静态资源 CDN ----
NEXT_PUBLIC_CDN_URL=""

# ---- WebSocket (排行榜实时推送) ----
# 部署到 Vercel 时使用外部 ws 服务
WS_SERVER_URL="ws://localhost:8080"
NEXT_PUBLIC_WS_SERVER_URL="ws://localhost:8080"

# ---- 应用配置 ----
NEXT_PUBLIC_DEFAULT_SESSION_LIMIT_MIN="20"
NEXT_PUBLIC_WEEKLY_LEADERBOARD_SIZE="50"
